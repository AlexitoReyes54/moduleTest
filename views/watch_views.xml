<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LISTA -->
    <record id="view_product_watch_tree" model="ir.ui.view">
        <field name="name">product.watch.list</field>
        <field name="model">product.watch</field>
        <field name="arch" type="xml">
            <list string="Watches">
                <field name="reference"/>
                <field name="name"/>
                <field name="brand"/>
                <field name="family"/>
                <field name="movement"/>
                <field name="limited"/>
            </list>
        </field>
    </record>

    <!-- VISTA FORM -->
    <record id="view_product_watch_form" model="ir.ui.view">
        <field name="name">product.watch.form</field>
        <field name="model">product.watch</field>
        <field name="arch" type="xml">
            <form string="Watch">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="brand"/>
                            <field name="family"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="movement"/>
                            <field name="limited"/>
                            <field name="image"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter watch description here..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCIÓN DE VENTANA -->
    <record id="action_product_watch" model="ir.actions.act_window">
        <field name="name">Watches</field>
        <field name="res_model">product.watch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first watch entry!
            </p>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_watch_root" 
              name="Watch Store" 
              sequence="10"/>

    <menuitem id="menu_watch_catalog" 
              name="Catalog" 
              parent="menu_watch_root" 
              sequence="1"/>

    <menuitem id="menu_product_watch" 
              name="Watches" 
              parent="menu_watch_catalog" 
              action="action_product_watch" 
              sequence="1"/>

    <menuitem id="menu_product_reloj" 
              name="Relojes" 
              parent="menu_watch_catalog" 
              action="action_product_watch" 
              sequence="2"/>
</odoo>
